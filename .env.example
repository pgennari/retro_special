# Backend local (npm start)
PORT=3030
HOST=0.0.0.0

# Em localhost, deixe vazio para liberar qualquer origem.
# No Render, use as origens do Firebase Hosting separadas por vírgula.
ALLOWED_ORIGINS=

# Persistência no Firestore (opcional em desenvolvimento).
# Sem estas variáveis as salas ficam apenas em memória.
FIREBASE_PROJECT_ID=retro-special-pgennari
FIREBASE_SERVICE_ACCOUNT=

# Alternativa ao JSON inline: caminho para o arquivo da service account.
# GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\service-account.json
